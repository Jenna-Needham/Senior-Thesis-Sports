race_trends <- my_dataset %>%
filter(!is.na(race_group)) %>%
group_by(year, race_group) %>%
summarise(
weighted_n = sum(weight),
.groups = "drop"
) %>%
group_by(year) %>%
mutate(
percent = weighted_n / sum(weighted_n) * 100
) %>%
ungroup()
race_trends %>%
group_by(year) %>%
summarise(total_percent = sum(percent))
p_race <- ggplot(
race_trends,
aes(
x = year,
y = percent,
fill = race_group
)
) +
geom_area(position = "stack") +
labs(
title = "Race/Ethnicity Composition",
x = "Year",
y = "Percent",
fill = "Race/Ethnicity"
) +
scale_x_continuous(
breaks = c(1997, 2007, 2017, 2023)
) +
scale_y_continuous(
breaks = seq(0, 100, 20)
) +
coord_cartesian(
ylim = c(0, 100)
) +
scale_fill_brewer(
palette = "Set2"
) +
theme_minimal()
combined_trends <- (
p_deviance | p_sports
) / (
p_nicotine | p_race
)
combined_trends
