# Create a prediction grid for age
# Assuming age ranges from ~10 to ~30 based on typical sports participation data
# We'll hold female and race_group constant (female = 0, race_group = "White")
prediction_grid <- data.frame(
age = seq(10, 30, by = 1),
female = 0,
race_group = factor("White", levels = c("White", "American Indian/Alaska Native", "Asian/Pacific Islander", "Black", "Hispanic", "Other/Multiracial"))
)
# Generate predictions for each year
# We use type = "response" to get the predicted probability
predictions <- prediction_grid |>
mutate(
prob_1997 = predict(glm_sports_1997, newdata = ., type = "response"),
prob_2007 = predict(glm_sports_2007, newdata = ., type = "response"),
prob_2017 = predict(glm_sports_2017, newdata = ., type = "response"),
prob_2023 = predict(glm_sports_2023, newdata = ., type = "response")
)
# Reshape for plotting
plot_data <- predictions |>
tidyr::pivot_longer(
cols = starts_with("prob_"),
names_to = "Year",
values_to = "Probability"
) |>
mutate(Year = str_remove(Year, "prob_")) |>
mutate(Year = factor(Year, levels = c("1997", "2007", "2017", "2023")))
# Create the plot
ggplot(plot_data, aes(x = age, y = Probability, color = Year, group = Year)) +
geom_line(size = 1) +
geom_point() +
labs(
title = "Predicted Probability of Sports Participation by Age",
subtitle = "Models held female and race_group constant (White, Male)",
x = "Age",
y = "Predicted Probability"
) +
theme_minimal()
